        }
      }
    },
    "onboarding.account.guideHint": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začínáte se správou osobních financí? Po přihlášení můžete kdykoliv otevřít sekci „Průvodce“ v menu (vpravo nahoře), kde najdete krok za krokem návody a tipy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New to personal finance tracking? After signing in, you can open the “Guide” anytime from the menu (top right) for step-by-step examples and tips."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вперше ведете облік особистих фінансів? Після входу ви будь-коли зможете відкрити розділ «Посібник» у меню (у верхньому правому куті), де знайдете покрокові приклади та корисні поради."
          }
        }
      }
    },
