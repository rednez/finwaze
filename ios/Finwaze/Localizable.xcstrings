    "onboarding.budget.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set monthly spending limits for individual categories and track your progress in real time. Finwaze helps you spot overspending risks before they happen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлюйте місячні ліміти витрат для окремих категорій і стежте за прогресом у реальному часі. Finwaze допоможе помітити ризик перевитрат ще до того, як вони стануть проблемою."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte měsíční limity výdajů pro jednotlivé kategorie a sledujte svůj pokrok v reálném čase. Finwaze vám pomůže odhalit riziko překročení rozpočtu ještě předtím, než nastane."
          }
        }
      }
