    "onboarding.account.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To start tracking your finances in Finwaze, you need at least one account. Choose a name and currency — you can always add more accounts later."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб почати вести облік фінансів у Finwaze, потрібен принаймні один рахунок. Виберіть назву та валюту — за потреби ви завжди зможете додати інші рахунки пізніше."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
