    "onboarding.transactions.description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenávejte příjmy, výdaje, převody mezi účty a úpravy zůstatku. Každá transakce ukládá měnu operace a skutečně připsanou nebo odepsanou částku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record income, expenses, transfers between accounts, and balance adjustments. Each transaction stores the operation currency and the actual amount credited or debited."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фіксуйте доходи, витрати, перекази між рахунками та коригування залишку. Для кожної транзакції зберігаються валюта операції та фактична сума списання або зарахування на рахунок."
          }
        }
      }
    },
