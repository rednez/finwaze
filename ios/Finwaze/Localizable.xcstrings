    },
    "onboarding.categories.description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizujte transakce pomocí skupin a kategorií, které odpovídají vašemu životnímu stylu — například „Auto → Palivo“ nebo „Služby → Předplatné“. Jasná struktura pomáhá lépe porozumět financím."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Structure your transactions using groups and categories that match your lifestyle — for example, “Car → Fuel” or “Services → Subscriptions”. A clear structure helps you better understand your finances."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Організовуйте транзакції за групами та категоріями, які відповідають саме вашому способу життя — наприклад, «Авто → Пальне» або «Послуги → Підписки». Чітка структура допомагає краще розуміти свої фінанси."
          }
        }
      }
    },
