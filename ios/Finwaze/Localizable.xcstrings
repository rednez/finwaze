    "onboarding.welcome.description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Finwaze spojuje všechny vaše účty, transakce a finanční cíle do jednoho přehledného místa. Tato krátká úvodní prohlídka vám ukáže hlavní funkce aplikace — zabere jen minutu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finwaze brings all your accounts, transactions, and financial goals into one simple place. This short introduction will walk you through the main features — it only takes a minute."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Finwaze об’єднує всі ваші рахунки, транзакції та фінансові цілі в одному зручному місці. Це коротке знайомство покаже основні можливості застосунку — воно займе лише хвилину."
          }
        }
      }
    },
