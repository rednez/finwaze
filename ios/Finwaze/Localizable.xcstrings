    "onboarding.goals.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create dedicated savings goals with separate accounts. Track your progress and stay motivated as your balance grows."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створюйте окремі цілі заощаджень із власними рахунками. Відстежуйте свій прогрес і зберігайте мотивацію, спостерігаючи, як зростають ваші накопичення."
          }
        },
        "cs": {
          "stringUnit": {
