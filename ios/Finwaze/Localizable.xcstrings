    "accountSettings.deleteConfirmMessage %@": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet „%@“ bude smazán i s opravami zůstatku. Tuto akci nelze vrátit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will be deleted with its balance corrections. This cannot be undone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок «%@» буде видалено разом із корекціями балансу. Цю дію неможливо скасувати."
          }
        }
      }
    },
